te": "地铁起步3元、按里程计程[6]；三日票40元[6]，加公交与零星打车预留；公交票价未核实"}, {"label": "餐饮3天", "low": "450", "high": "600", "quantity": "1", "divisor": "1", "kind": "estimate", "note": "按每日150—200元安排，含1—2顿特色正餐"}, {"label": "机动", "low": "100", "high": "150", "quantity": "1", "divisor": "1", "kind": "estimate", "note": "零食、饮水、寄存、临时改线"}]}]}}
