OPENAI_API_KEY=replace-with-your-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-a-tool-calling-model
# 可选：模型单次回答的最大输出长度，不是整次研究的累计 Token 预算
OPENAI_MAX_TOKENS=
TAVILY_API_KEY=
# 运行方式：local 保留进程内任务；distributed 使用 MySQL、Redis 和独立 Worker
DEEPTRACE_RUNTIME_MODE=local
DEEPTRACE_MYSQL_DSN=mysql+asyncmy://researchpilot:researchpilot@mysql:3306/researchpilot
DEEPTRACE_REDIS_URL=redis://redis:6379/0
DEEPTRACE_REDIS_JOB_STREAM=deeptrace:research:jobs
DEEPTRACE_REDIS_CONSUMER_GROUP=research-workers
DEEPTRACE_REDIS_CONSUMER_NAME=worker-1
DEEPTRACE_REDIS_CLAIM_IDLE_MS=60000
DEEPTRACE_WORKER_LEASE_SECONDS=120
DEEPTRACE_WORKER_MAX_ATTEMPTS=3
DEEPTRACE_REDIS_CANCEL_TTL_SECONDS=86400
DEEPTRACE_MAX_PAGE_CHARS=20000
DEEPTRACE_EMBEDDING_MODEL_PATH=D:\Dev\Models\bge-m3
DEEPTRACE_EMBEDDING_BATCH_SIZE=8
DEEPTRACE_MEMORY_RETRIEVAL=semantic
# Local 留空后使用持久化目录；Distributed 必须配置 Chroma HTTP 地址
DEEPTRACE_CHROMA_URL=
DEEPTRACE_CHROMA_PERSIST_PATH=chroma
DEEPTRACE_CHROMA_COLLECTION=deeptrace-long-term-memory
DEEPTRACE_MEMORY_TOP_K=5
DEEPTRACE_MIN_EXTRACTED_CHARS=500
DEEPTRACE_MIN_EXTRACTED_TOKENS=200
DEEPTRACE_ALLOW_BENCHMARK_DNS_PROXY=false
DEEPTRACE_SEARCH_QUERY_COUNT=3
DEEPTRACE_MAX_SEARCH_RESULTS_PER_QUERY=5
DEEPTRACE_SCRAPER_CONCURRENCY=15
DEEPTRACE_CONTEXT_MAX_RESULTS=10
DEEPTRACE_CONTEXT_DIRECT_THRESHOLD_CHARS=8000
DEEPTRACE_CONTEXT_CHUNK_CHARS=1000
DEEPTRACE_CONTEXT_CHUNK_OVERLAP_CHARS=100
DEEPTRACE_CONTEXT_SIMILARITY_THRESHOLD=0.42
DEEPTRACE_PLANNER_TIMEOUT_SECONDS=60
DEEPTRACE_WRITER_TIMEOUT_SECONDS=60
DEEPTRACE_MAX_FETCHED_PAGES=20
DEEPTRACE_MAX_TOOL_CALLS=30
DEEPTRACE_TOOL_TIMEOUT_SECONDS=45
# Plan-and-Execute 兼容配置：任务与重规划上限
DEEPTRACE_DEEP_CALL_TIMEOUT_SECONDS=45
DEEPTRACE_DEEP_MAX_TASKS=6
DEEPTRACE_DEEP_MAX_ROUNDS_PER_TASK=4
DEEPTRACE_DEEP_MAX_STEPS=12
DEEPTRACE_DEEP_MAX_REPLANS=2
DEEPTRACE_DEEP_MAX_TOOL_CALLS=30
DEEPTRACE_DEEP_MEMORY_MAX_AGE_DAYS=7
# Multi-Agent 模式：Supervisor 批次调度与独立 Researcher
DEEPTRACE_MULTI_AGENT_MAX_RESEARCHERS=6
DEEPTRACE_MULTI_AGENT_MAX_BATCH_SIZE=3
DEEPTRACE_MULTI_AGENT_CONCURRENCY=3
DEEPTRACE_MULTI_AGENT_MAX_SUPERVISOR_ROUNDS=3
# 每个 Researcher 的总模型决策轮数，包含最后一次只收尾的决策
DEEPTRACE_MULTI_AGENT_MAX_RESEARCHER_ROUNDS=3
DEEPTRACE_MULTI_AGENT_MAX_TOOL_CALLS=30
DEEPTRACE_MULTI_AGENT_MAX_TOOLS_PER_RESEARCHER=10
DEEPTRACE_MULTI_AGENT_CALL_TIMEOUT_SECONDS=45
DEEPTRACE_MULTI_AGENT_MEMORY_MAX_AGE_DAYS=7
DEEPTRACE_MULTI_AGENT_MEMORY_PATH=memory/multi-agent-pages.jsonl
# 跨运行复用已抓取页面
DEEPTRACE_USE_MEMORY=false
DEEPTRACE_MEMORY_PATH=memory/pages.jsonl
# Provider 单价未知时留空；费用仅作估算，不触发研究停止。
DEEPTRACE_INPUT_COST_PER_MILLION=
DEEPTRACE_OUTPUT_COST_PER_MILLION=
