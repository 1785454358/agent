OPENAI_API_KEY=replace-with-your-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-a-tool-calling-model
TAVILY_API_KEY=
DEEPTRACE_MAX_STEPS=8
DEEPTRACE_MAX_PAGE_CHARS=20000
DEEPTRACE_EMBEDDING_MODEL_PATH=D:\Dev\Models\bge-m3
DEEPTRACE_MIN_RELEVANCE_SCORE=0.45
DEEPTRACE_EMBEDDING_BATCH_SIZE=8
DEEPTRACE_MIN_EXTRACTED_CHARS=500
DEEPTRACE_MIN_EXTRACTED_TOKENS=200
DEEPTRACE_SOFT_MAX_STEPS=8
DEEPTRACE_HARD_MAX_STEPS=12
DEEPTRACE_QUERY_LOOP_THRESHOLD=0.85
DEEPTRACE_TOKEN_ENCODING=cl100k_base
DEEPTRACE_ALLOW_BENCHMARK_DNS_PROXY=false
DEEPTRACE_MAX_RESEARCH_TASKS=4
DEEPTRACE_MAX_TASK_ROUNDS=3
DEEPTRACE_MIN_SOURCES_PER_TASK=2
DEEPTRACE_MAX_FETCHED_PAGES=20
DEEPTRACE_MAX_RUNTIME_SECONDS=600
DEEPTRACE_TASK_CONCURRENCY=2
# 跨运行复用已抓取页面（研究记忆）
DEEPTRACE_USE_MEMORY=false
DEEPTRACE_MEMORY_PATH=memory/notes.jsonl
# Provider 单价未知时留空；设置费用上限必须同时配置输入和输出单价。
DEEPTRACE_INPUT_COST_PER_MILLION=
DEEPTRACE_OUTPUT_COST_PER_MILLION=
DEEPTRACE_MAX_COST_USD=
