# Copy this file to .env.docker and replace every placeholder before starting.
OPENAI_API_KEY=replace-with-your-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-a-tool-calling-model
TAVILY_API_KEY=replace-with-your-real-key

# Use forward slashes for a Windows host path, for example D:/models/bge-m3.
# The directory must exist on this machine; docker compose validates the bind mount.
DEEPTRACE_EMBEDDING_MODEL_HOST_PATH=path/to/bge-m3

# Local-development database passwords only. Use secret management in production.
MYSQL_PASSWORD=researchpilot
MYSQL_ROOT_PASSWORD=root-local-only
