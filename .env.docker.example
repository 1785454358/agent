# Copy this file to .env.docker and replace every placeholder before starting.
OPENAI_API_KEY=replace-with-your-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-a-tool-calling-model
DEEPTRACE_MODEL_THINKING=auto
TAVILY_API_KEY=replace-with-your-real-key

DEEPTRACE_AGENT_MAX_ITERATIONS=24
DEEPTRACE_AGENT_MAX_PAGES=8
DEEPTRACE_MAX_FETCHED_PAGES=80
DEEPTRACE_MAX_TOOL_CALLS=240
# Batch acquisition and shared model budget for one research question.
DEEPTRACE_RESEARCH_SOURCE_TARGET=3
DEEPTRACE_MAX_MODEL_CALLS=20
DEEPTRACE_MAX_INPUT_TOKENS=100000
DEEPTRACE_RESEARCH_MAX_SECONDS=600
DEEPTRACE_EVALUATOR_TIMEOUT_SECONDS=120

# Replace this relative example with your BGE-M3 directory when needed.
# Forward slashes also work for an absolute Windows path, for example D:/models/bge-m3.
DEEPTRACE_EMBEDDING_MODEL_HOST_PATH=./models/bge-m3

# Local-development database passwords only. Use secret management in production.
MYSQL_PASSWORD=deepresearch
MYSQL_ROOT_PASSWORD=root-local-only
